# Copy this file to .env and adjust values before running docker-compose up

# MySQL
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_DATABASE=finance_tracker
MYSQL_USER=finance_user
MYSQL_PASSWORD=finance_pass

# MongoDB
MONGO_DATABASE=finance_tracker_mongo

# JWT — replace with a long random string in any real deployment
JWT_SECRET=change-this-super-secret-key-in-production-minimum-256-bits-long
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
